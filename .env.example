# SMTP for appointment-request emails (e.g. Gmail with an App Password: smtp.gmail.com / 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Recipient (defaults to the clinic email in src/content/site.ts)
MAIL_TO=
MAIL_FROM=

# Admin panel (/admin)
ADMIN_PASSWORD=
# Optional: separate secret for signing the login cookie (defaults to ADMIN_PASSWORD)
ADMIN_SECRET=
# Where admin saves articles on Vercel: commits to this repo (fine-grained token, Contents: read & write)
GITHUB_TOKEN=
GITHUB_REPO=kostastsikalas/andromidas_ioannis
GITHUB_BRANCH=main
